# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# must never be committed.
#
#   cp .env.example .env
#   $EDITOR .env
#
# Document every environment variable the crates, their tests, or the examples
# read, including optional ones, with a placeholder value and a comment saying
# what it is for. `.env.example` is the contract; `.env` is the secret.

# Socket address the API server listens on. Port 0 picks a free port and the
# server prints the address it bound.
# TINYBACKROOMS_ADDR=127.0.0.1:8080

# Model backend for the API server. `demo` fabricates schema-valid output and
# needs no credentials.
# TINYBACKROOMS_BACKEND=demo

# Log filter for the `tracing`/`env_logger` style ecosystem.
# RUST_LOG=info

# --- The `openhuman` backend (build with `--features openhuman`) ---------------

# Required. Bearer token for the model provider. Never commit a real one.
# TINYBACKROOMS_OPENHUMAN_API_KEY=replace-me

# OpenAI-compatible API base URL.
# TINYBACKROOMS_OPENHUMAN_BASE_URL=https://openrouter.ai/api/v1

# Model used when a request names none.
# TINYBACKROOMS_OPENHUMAN_MODEL=openai/gpt-oss-120b:nitro

# Per-turn deadline in seconds; a turn past it is abandoned.
# TINYBACKROOMS_OPENHUMAN_TURN_TIMEOUT_SECS=300

# Backtraces for local debugging: 1 for a short backtrace, "full" for all frames.
# RUST_BACKTRACE=1
